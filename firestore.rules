rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /artPieces/{pieceId} {
      // Anyone can read the gallery (public site).
      allow read: if true;

      // Only the site's admin account can create/edit/delete pieces.
      allow write: if request.auth != null
        && request.auth.token.email == 'moriahguy@gmail.com';
    }
  }
}
